<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aisle_robot">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <!-- Model origin is at the drive axle projected onto the floor. Local +X is forward. -->
    <link name="chassis">
      <pose>-0.06 0 0.33 0 0 0</pose>
      <inertial>
        <!-- Concentrate battery mass low and slightly rearward for faster braking. -->
        <pose>-0.03 0 -0.12 0 0 0</pose>
        <mass>7</mass>
        <inertia><ixx>0.1866666667</ixx><iyy>0.1866666667</iyy><izz>0.1866666667</izz></inertia>
      </inertial>
      <visual name="black_cube">
        <geometry><box><size>0.40 0.40 0.40</size></box></geometry>
        <material><ambient>0.025 0.025 0.025 1</ambient><diffuse>0.035 0.035 0.035 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
      <collision name="cube_collision">
        <geometry><box><size>0.40 0.40 0.40</size></box></geometry>
      </collision>
      <visual name="front_marker">
        <pose>0.201 0 -0.07 0 0 0</pose>
        <geometry><box><size>0.003 0.10 0.025</size></box></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
    </link>
    <link name="left_wheel">
      <pose>0 0.25 0.11 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.000808333333</ixx><iyy>0.0015125</iyy><izz>0.000808333333</izz></inertia>
      </inertial>
      <visual name="tire">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.09 0.09 0.09 1</ambient><diffuse>0.09 0.09 0.09 1</diffuse></material>
      </visual>
      <visual name="rotation_spoke">
        <pose>0 0.027 0 0 0 0</pose>
        <geometry><box><size>0.18 0.005 0.015</size></box></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
      </visual>
      <collision name="tire_contact">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="right_wheel">
      <pose>0 -0.25 0.11 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.000808333333</ixx><iyy>0.0015125</iyy><izz>0.000808333333</izz></inertia>
      </inertial>
      <visual name="tire">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.09 0.09 0.09 1</ambient><diffuse>0.09 0.09 0.09 1</diffuse></material>
      </visual>
      <visual name="rotation_spoke">
        <pose>0 -0.027 0 0 0 0</pose>
        <geometry><box><size>0.18 0.005 0.015</size></box></geometry>
        <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
      </visual>
      <collision name="tire_contact">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>
    <link name="support_ball">
      <pose>-0.23 0 0.045 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0000405</ixx><iyy>0.0000405</iyy><izz>0.0000405</izz></inertia>
      </inertial>
      <visual name="ball_visual">
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <material><ambient>0.09 0.09 0.09 1</ambient><diffuse>0.09 0.09 0.09 1</diffuse></material>
      </visual>
      <collision name="ball_contact">
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <pose relative_to="left_wheel">0 0 0 0 0 0</pose>
      <parent>chassis</parent><child>left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>10</effort><velocity>220</velocity></limit>
        <dynamics><damping>0.001</damping></dynamics>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <pose relative_to="right_wheel">0 0 0 0 0 0</pose>
      <parent>chassis</parent><child>right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper><effort>10</effort><velocity>220</velocity></limit>
        <dynamics><damping>0.001</damping></dynamics>
      </axis>
    </joint>
    <joint name="support_ball_joint" type="ball">
      <pose relative_to="support_ball">0 0 0 0 0 0</pose>
      <parent>chassis</parent><child>support_ball</child>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.50</wheel_separation><wheel_radius>0.11</wheel_radius>
      <max_linear_velocity>20</max_linear_velocity>
      <min_linear_acceleration>-3</min_linear_acceleration>
      <max_linear_acceleration>3</max_linear_acceleration>
      <topic>/step1/cmd_vel</topic><odom_topic>/step1/wheel_odometry</odom_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <frame_id>aisle_robot/odom</frame_id><child_frame_id>aisle_robot/chassis</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose><publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose><publish_sensor_pose>false</publish_sensor_pose>
      <publish_model_pose>true</publish_model_pose><publish_nested_model_pose>true</publish_nested_model_pose>
      <static_publisher>false</static_publisher>
      <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>100</update_frequency>
    </plugin>
  </model>
</sdf>
